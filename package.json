{
  "name": "secretbridge-workspace",
  "private": true,
  "version": "0.3.0-beta.1",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.23 <12"
  },
  "scripts": {
    "build": "pnpm --dir frontend build",
    "dev:web": "pnpm --dir frontend dev",
    "format:web": "prettier --write \"frontend/src/**/*.{ts,tsx,css}\" \"tools/acceptance/*.mjs\"",
    "format:web:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css}\" \"tools/acceptance/*.mjs\"",
    "test": "pnpm --dir frontend test",
    "test:browser": "python tools/acceptance/test_browser_acceptance.py",
    "test:personal-scale": "python tools/acceptance/test_personal_scale.py",
    "typecheck": "pnpm --dir frontend typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8"
  }
}
